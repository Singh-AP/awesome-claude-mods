      },
      "homepage": "https://github.com/Singh-AP/awesome-claude-mods/tree/main/mods/safety/secret-shield"
    },
    {
      "name": "net-guard",
      "source": "./mods/safety/net-guard",
      "description": "Stops data exfiltration and surprise network calls: checks every curl, wget, ssh, scp, git push and WebFetch against allow and deny lists, and asks before data goes to a host you haven't approved.",
      "version": "1.0.0",
      "category": "safety",
      "tags": [
        "mod",
        "safety",
        "network",
        "exfiltration",
        "allowlist",
        "curl",
        "yolo"
      ],
