{
  "$schema": "https://anthropic.com/claude-code/marketplace.schema.json",
  "name": "awesome-claude-mods",
  "owner": {
    "name": "Singh-AP",
    "url": "https://github.com/Singh-AP"
  },
  "metadata": {
    "description": "Tested, ready-to-install Claude Code mods: guardrails, status lines, panes, notifications and fun.",
    "version": "1.0.0"
  },
  "plugins": [
    {
      "name": "bash-guard",
      "source": "./mods/safety/bash-guard",
      "description": "A seatbelt for YOLO mode: blocks catastrophic shell commands (rm -rf ~, mkfs, dd to a disk, fork bombs) and asks before risky ones (force-push, reset --hard, DROP TABLE, curl | sh), even with permissions bypassed.",
      "version": "1.0.0",
      "category": "safety",
      "tags": [
        "mod",
        "safety",
        "bash",
        "guardrails",
        "yolo"
      ],
      "author": {
        "name": "awesome-claude-mods",
        "url": "https://github.com/Singh-AP/awesome-claude-mods"
      },
      "homepage": "https://github.com/Singh-AP/awesome-claude-mods/tree/main/mods/safety/bash-guard"
    },
    {
      "name": "file-guard",
      "source": "./mods/safety/file-guard",
      "description": "Keeps Claude's file edits inside the project: refuses writes outside it (symlinks resolved), never lets a tool touch .git internals, and asks before it changes lockfiles, CI workflows, migrations or secrets.",
      "version": "1.0.0",
      "category": "safety",
      "tags": [
        "mod",
        "safety",
        "files",
        "guardrails",
        "sandbox",
        "yolo"
      ],
      "author": {
        "name": "awesome-claude-mods",
        "url": "https://github.com/Singh-AP/awesome-claude-mods"
      },
      "homepage": "https://github.com/Singh-AP/awesome-claude-mods/tree/main/mods/safety/file-guard"
    },
    {
      "name": "secret-shield",
      "source": "./mods/safety/secret-shield",
      "description": "Keeps secrets out of Claude's context: API keys, tokens, private keys and passwords in tool output are replaced with [REDACTED:kind] before the model or the transcript ever sees them.",
      "version": "1.0.0",
      "category": "safety",
      "tags": [
        "mod",
        "safety",
        "secrets",
        "redaction",
        "security",
        "dlp"
      ],
      "author": {
        "name": "awesome-claude-mods",
